# ─── Database ────────────────────────────────────────────────
DB_NAME=blackbox_db
DB_USER=blackbox
DB_PASSWORD=change_me_strong_password   # 필수: 변경 필요

# ─── JWT ─────────────────────────────────────────────────────
# openssl rand -hex 32  로 생성 권장
JWT_SECRET=change_me_at_least_32_chars_long_secret

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
FRONTEND_BASE_URL=https://your-domain.com   # 도메인 설정 후 변경

# ─── AI (OpenAI / GPT) ───────────────────────────────────────
OPENAI_API_KEY=sk-...                        # 선택: AI 분석 기능 필요 시

# ─── Google OAuth (선택 — Google Calendar/Drive 연동) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/google/oauth/callback

# ─── Notion (선택 — 설정 UI에서 프로젝트별 입력 가능) ───────────
# NOTION_TOKEN, NOTION_DATABASE_ID 는 프로젝트 설정 UI에서 입력

# ─── File Storage ────────────────────────────────────────────
FILE_UPLOAD_DIR=/data/uploads               # Docker 볼륨 마운트 경로 (변경 불필요)
